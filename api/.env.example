# ===============================================
# MyOwnClone - Environment Variables Template
# ===============================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# DO NOT COMMIT .env WITH REAL CREDENTIALS
# ===============================================

# DATABASE (OBLIGATORY - no defaults, fail-fast in app_factory._validate_required_env)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myownclone

# REDIS (OBLIGATORY - no defaults)
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (OBLIGATORY in production, must be >= 32 chars, see auth._get_secret_key)
JWT_SECRET_KEY=

# IMPERSONATION TOKEN PEPPER (OBLIGATORY in production, used to hash impersonation tokens)
IMPERSONATION_TOKEN_PEPPER=

# CORS — frontend origins (comma-separated, sin espacios)
# En producción debe ser solo el dominio real (ej: https://myownclone.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,https://myownclone.vercel.app

# FLASK
FLASK_APP=app_factory
FLASK_ENV=development

# WEAVIATE
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# STRIPE (required for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EMAIL (Resend)
RESEND_API_KEY=

# LLM PROVIDERS (optional for dev, required for production)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# ===============================================
# SECURITY NOTES:
# - DB_PASSWORD and REDIS_PASSWORD are MANDATORY
# - The app will FAIL TO START if these are missing or weak
# - Never use 'postgres', 'changeit', or 'dev_password_123' as passwords
# - JWT_SECRET_KEY must be >= 32 chars; the app refuses to start in
#   production if it's the dev default or too short
# ===============================================

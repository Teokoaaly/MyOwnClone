# ===============================================
# MyOwnClone - Environment Variables Template
# ===============================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# DO NOT COMMIT .env WITH REAL CREDENTIALS
# ===============================================

# DATABASE (OBLIGATORY - no defaults)
DB_USER=postgres
DB_PASSWORD=<change-this-to-a-strong-password>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myownclone

# REDIS (OBLIGATORY - no defaults)
REDIS_PASSWORD=<change-this-to-a-strong-password>
REDIS_HOST=localhost
REDIS_PORT=6379

# FLASK
FLASK_APP=app_factory
FLASK_ENV=development

# API KEYS (optional for development, required for production)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=

# WEAVIATE
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ===============================================
# SECURITY NOTES:
# - DB_PASSWORD and REDIS_PASSWORD are MANDATORY
# - The app will FAIL TO START if these are missing
# - Never use 'postgres', 'changeit', or 'dev_password_123' as passwords
# ===============================================
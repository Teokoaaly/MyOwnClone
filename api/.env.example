# ===============================================
# MyOwnClone - Environment Variables Template
# ===============================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# DO NOT COMMIT .env WITH REAL CREDENTIALS
# ===============================================

# === Flask ===
FLASK_APP=app_factory
FLASK_ENV=development
SECRET_KEY=

# === Auth (JWT) ===
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600

# === Impersonation token pepper (OBLIGATORY in production) ===
IMPERSONATION_TOKEN_PEPPER=

# === Database (OBLIGATORY - no defaults, fail-fast en app_factory._validate_required_env) ===
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/myownclone
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myownclone

# === Redis (OBLIGATORY - no defaults) ===
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# === CORS — frontend origins (comma-separated, sin espacios) ===
# En producción debe ser solo el dominio real (ej: https://myownclone.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,https://myownclone.vercel.app

# === Models / LLM providers (optional for dev, required for production) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# === Weaviate (vector DB) ===
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# === Storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# === Stripe (required for billing) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Email ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# === Platform Admin (for initial setup / seeding) ===
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
# Generate hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"

# === Deploy Secret (for /api/deploy endpoint — keep it strong!) ===
DEPLOY_SECRET=

# ===============================================
# SECURITY NOTES:
# - DB_PASSWORD and REDIS_PASSWORD are MANDATORY
# - The app will FAIL TO START if these are missing or weak
# - Never use 'postgres', 'changeit', or 'dev_password_123' as passwords
# - JWT_SECRET_KEY must be >= 32 chars; the app refuses to start in
#   production if it's the dev default or too short
# - IMPERSONATION_TOKEN_PEPPER must be set in production
# ===============================================

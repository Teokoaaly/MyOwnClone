# MyOwnClone — required environment variables
#
# Copy this file to .env and fill in the values. Do NOT commit .env.
#
# Set FLASK_ENV to "development" for local dev (enables permissive dev
# stubs in wraps.py and accepts default weak secrets). Leave unset (or set
# to "production") in any deployed environment.

FLASK_ENV=development

# --- Database (REQUIRED in all environments) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=myownclone
# DB_PASSWORD must NOT be "postgres" or "changeit"; the app refuses to start otherwise.
DB_PASSWORD=changeit
# DB_USERNAME / DB_DATABASE are accepted by auth.py (uses DB_USERNAME/DB_DATABASE,
# the app factory uses DB_USER/DB_NAME — keep both in sync).
DB_USERNAME=postgres
DB_DATABASE=myownclone

# --- Redis (REQUIRED in all environments) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeit
REDIS_USERNAME=default

# --- API keys (optional in dev, recommended in prod) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# --- Stripe (optional in dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOok_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=

# --- Email (optional in dev) ---
RESEND_API_KEY=
INBOUND_EMAIL_DOMAIN=

# --- Auth (REQUIRED, with sane defaults in dev only) ---
# JWT_SECRET_KEY signs the user JWTs (HS256). In production it MUST be a
# strong unique value; the app refuses to start with the default.
JWT_SECRET_KEY=dev-secret-change-me
# PLATFORM_ADMIN_TOKEN is the service-to-service token used by the Next.js
# admin proxy. Required in production.
PLATFORM_ADMIN_TOKEN=
# IMPERSONATION_TOKEN_PEPPER is mixed into SHA-256 hashes of impersonation
# tokens. Required in production; the app refuses to start with the default.
IMPERSONATION_TOKEN_PEPPER=dev-pepper-rotate-in-prod

# --- CORS (comma-separated allowlist; empty disables CORS) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Next.js proxy URL (the Flask backend uses it as a return URL) ---
MYOWNCLONE_API_URL=http://localhost:5001

# --- Dev / staging overrides (DO NOT SET IN PRODUCTION) ---
# DEV_PLATFORM_ADMIN_BYPASS=true lets any logged-in request reach the admin
# endpoints without a real role check. Use only in dev.
DEV_PLATFORM_ADMIN_BYPASS=false

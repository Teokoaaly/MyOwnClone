[Unit]
Description=MyOwnClone frontend (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myownclone
Group=myownclone
WorkingDirectory=/opt/myownclone/current/MyOwnClone
EnvironmentFile=/opt/myownclone/shared/frontend.env.production
ExecStart=/usr/bin/npm run start -- --hostname ${HOSTNAME} --port ${PORT}
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Copiar a /opt/myownclone/shared/frontend.env.production en el VPS.
# Variables mínimas para next start + NextAuth/Auth.js detrás de reverse proxy o IP pública.

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Base de datos usada por Drizzle/NextAuth
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/myownclone

# Backend Flask que consume el frontend SSR/API routes.
# Si el script smoke corre dentro del VPS, esto puede quedar en loopback.
MYOWNCLONE_API_URL=http://127.0.0.1:5001
DEFAULT_CLONE_ID=
PLATFORM_ADMIN_TOKEN=
DEFAULT_PLAN=trial

# Auth.js / NextAuth hardening:
# - AUTH_URL y NEXTAUTH_URL deben apuntar al URL público canónico del frontend.
# - AUTH_SECRET y NEXTAUTH_SECRET deben ser el mismo secreto largo/aleatorio.
# - AUTH_TRUST_HOST=true cuando el frontend está detrás de nginx/caddy/traefik.
AUTH_URL=http://100.99.222.101
NEXTAUTH_URL=http://100.99.222.101
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-openssl-rand-hex-32-or-better
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32-or-better

# Bootstrap admin de emergencia/producción mientras no exista tabla `users` funcional.
# Genera el hash con:
#   node -e 'require("bcryptjs").hash(process.argv[1], 12).then(console.log)' "tu-password"
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD_HASH=

# Proveedores actualmente referenciados por src/lib/auth.ts
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@myownclone.local

# App/public URLs
NEXT_PUBLIC_APP_URL=http://100.99.222.101
NEXT_PUBLIC_API_URL=http://100.99.222.101:5001
NEXT_PUBLIC_ADMIN_URL=http://100.99.222.101/admin
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Otras integraciones si están activas
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SCALE_PRICE_ID=
SENDGRID_INBOUND_WEBHOOK_SECRET=
WHEREBY_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

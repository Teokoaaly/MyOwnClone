# Copiar a /opt/myownclone/shared/backend.env.production en el VPS.
# El deploy usa este fichero como env_file del docker compose de producción.

DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
WEAVIATE_API_KEY=change-me
JWT_SECRET_KEY=change-me

# Backend runtime
LOG_LEVEL=INFO
SECRET_KEY=change-me

# Integraciones opcionales/según tu uso real
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_INBOUND_WEBHOOK_SECRET=
WHEREBY_API_KEY=

# Si el backend necesita un host/base URL público en producción, defínelo aquí.
APP_URL=http://100.99.222.101

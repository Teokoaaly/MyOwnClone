# Copiar a /opt/myownclone/shared/backend.env.production en el VPS.
# El deploy usa este fichero como env_file del docker compose de producción.
#
# IMPORTANTE: app_factory._validate_required_env() rechaza:
#   - DB_PASSWORD == "postgres" o "changeit" o vacio
#   - REDIS_PASSWORD == "changeit" o vacio
#   - JWT_SECRET_KEY == "dev-secret-change-me" o longitud < 32
#   - IMPERSONATION_TOKEN_PEPPER == "dev-pepper-rotate-in-prod" o vacio
# Por tanto los placeholders 'change-me' deben sustituirse por valores fuertes
# ANTES del primer arranque, o el container no levantara.
#
# Genera secretos con: openssl rand -base64 48
# Genera pepper con:   openssl rand -base64 32

# ── Obligatorios (rechazados si son "change-me" o vacios) ──
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET_KEY=change-me-min-32-chars-randomly-generated
IMPERSONATION_TOKEN_PEPPER=change-me-min-32-chars-randomly-generated

# ── Variables de conexión (sobrescribibles si se usa DATABASE_URL) ──
DB_USER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=myownclone
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/myownclone
REDIS_TLS=true
REDIS_URL=rediss://redis:6380

# ── Flask runtime ──
FLASK_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=change-me

# ── CORS: SOLO el dominio público del frontend (comas, sin espacios) ──
ALLOWED_ORIGINS=https://myownclone.example.com

# ── Service-to-service: DEBE coincidir con MyOwnClone/.env.production ──
# El proxy Next.js envía este valor como X-API-Key al backend.
# Si no coincide, todos los /api/clone/* devuelven 401/403.
SERVICE_API_KEY=change-me
ALLOW_DEV_SERVICE_KEY=false

# ── Integraciones opcionales/según tu uso real ──
WEAVIATE_API_KEY=
WEAVIATE_URL=http://weaviate:8080
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_INBOUND_WEBHOOK_SECRET=
WHEREBY_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@myownclone.example.com

# ── URL pública del backend (usado en redirects, emails, webhooks) ──
APP_URL=https://myownclone.example.com

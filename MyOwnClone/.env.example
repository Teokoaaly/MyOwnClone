# =================================================================
# MyOwnClone — Frontend Environment Variables Template
# =================================================================
# COPY TO .env.local AND FILL IN VALUES
# DO NOT COMMIT .env.local WITH REAL CREDENTIALS
# =================================================================

# Supabase (if using Supabase as DB host — optional if using direct PG)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth — BOTH variables are used (v5 uses AUTH_SECRET, v4 used NEXTAUTH_SECRET)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                  # Generate: openssl rand -base64 32
AUTH_SECRET=                      # Same value as NEXTAUTH_SECRET (NextAuth v5 alias)

# Google OAuth (optional — only needed if Google login is enabled)
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Anthropic (primary LLM)
ANTHROPIC_API_KEY=sk-ant-

# OpenAI (embeddings + Whisper STT)
OPENAI_API_KEY=sk-

# Stripe
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_BASIC_PRICE_ID=price_
STRIPE_PRO_PRICE_ID=price_
STRIPE_SCALE_PRICE_ID=price_

# Resend (email outbound)
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@replica.tudominio.com

# SendGrid (email inbound parse webhook)
SENDGRID_INBOUND_WEBHOOK_SECRET=

# Whereby (video meetings)
WHEREBY_API_KEY=

# Upstash Redis (rate limiting — optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=https://
UPSTASH_REDIS_REST_TOKEN=

# Sentry (error tracking — optional)
NEXT_PUBLIC_SENTRY_DSN=https://
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (analytics — optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App URLs
NEXT_PUBLIC_APP_URL=https://replica.tudominio.com
NEXT_PUBLIC_API_URL=https://api.replica.tudominio.com
NEXT_PUBLIC_ADMIN_URL=https://admin.replica.tudominio.com

# Backend API URL (REQUIRED for proxy routes to Flask backend)
MYOWNCLONE_API_URL=http://localhost:5001

# Default Clone ID (REQUIRED for memories/analytics routes)
# After creating your first clone, copy its UUID here
DEFAULT_CLONE_ID=

# Platform Admin credentials (REQUIRED for /admin routes)
PLATFORM_ADMIN_TOKEN=
PLATFORM_ADMIN_EMAIL=admin@example.com
# Generate hash: node -e 'require("bcryptjs").hash(process.argv[1], 12).then(console.log)' "your-password"
PLATFORM_ADMIN_PASSWORD_HASH=
